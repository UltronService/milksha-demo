    "POST boxHeartbeat (interval after runtime start)",
    "POST devCommand (command ack / control)",
    "POST boxUpload",
    "POST posReceiver (not home board path)",
    "Firestore listener channel POST + possible command ack writes",
    "localStorage: milksha:deviceId, milksha:board-bind-record, milksha:board-machine-id"
